---
// src/layouts/Layout.Astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{ title } | MotherConnect</title>
	</head>
	<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
		<header class="bg-white border-b border-slate-200 shadow-sm">
			<div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
				<a href="/" class="text-xl font-bold text-pink-600 flex items-center gap-2">
					MotherConnect
				</a>
				<nav class="flex gap-6 text-sm font-medium text-slate-600">
					<a href="/" class="hover:text-pink-600 transition">Support Board</a>
					<a href="/posts/new" class="hover:text-pink-600 transition">Request Post</a>
					<a href="/login" id="auth-link" class="bg-pink-50 text-pink-600 px-3 py-1.5 rounded-lg border border-pink-200 hover:bg-pink-100 transition">Sign In</a>
				</nav>
			</div>
		</header>

		<!-- Main contents -->
		<main class="flex-1 max-w-4xl w-full mx-auto px-4 py-8">
			<slot />
		</main>
		<footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-400">
			&copy; 2026 MotherConnect - Community Childcare Support
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
