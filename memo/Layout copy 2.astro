---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | MomConnect</title>
    <!-- 【重要】最初からページ全体を隠しておく設定 -->
    <style>
      html { visibility: hidden; }
    </style>
  </head>
  <body class="bg-slate-50 min-h-screen text-slate-900">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-pink-600">MomConnect</a>
        <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-pink-600 transition">Support Board</a>
          <a href="/posts/new" class="hover:text-pink-600 transition">New Post</a>
          <button id="logout-btn" class="text-slate-500 hover:text-red-600 transition hidden">
            Sign Out
          </button>
          <a href="/login" id="login-link" class="bg-pink-50 text-pink-600 px-3 py-1.5 rounded-lg border border-pink-200 hover:bg-pink-100 transition hidden">
            Sign In
          </a>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- 認証チェック & 表示制御のスクリプト -->
    <script>
      import { supabase } from '../lib/supabase';

      const currentPath = window.location.pathname;
      const isAuthPage = currentPath === '/login' || currentPath === '/signup';

      const loginLink = document.getElementById('login-link');
      const logoutBtn = document.getElementById('logout-btn');

      // ユーザーのログイン状態をチェック
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (!session) {
          // 未ログインの場合
          if (!isAuthPage) {
            // ログインページ以外ならリダイレクト（中身は見せない）
            window.location.href = '/login';
          } else {
            // ログイン・登録ページなら、ログインボタンを表示し、ページを表示する
            loginLink?.classList.remove('hidden');
            logoutBtn?.classList.add('hidden');
            document.documentElement.style.visibility = 'visible'; // 画面を表示
          }
        } else {
          // ログイン済みの場合
          if (isAuthPage) {
            // すでにログインしているのに /login や /signup にいる場合はトップへ戻す
            window.location.href = '/';
          } else {
            // 通常ページならログアウトボタンを表示し、ページを表示する
            loginLink?.classList.add('hidden');
            logoutBtn?.classList.remove('hidden');
            document.documentElement.style.visibility = 'visible'; // 画面を表示
          }
        }
      });

      // ログアウトボタンの処理
      logoutBtn?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });
    </script>
  </body>
</html>