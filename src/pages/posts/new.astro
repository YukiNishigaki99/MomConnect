---
// src/pages/posts/new.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="New Post">
  <div class="max-w-xl mx-auto bg-white border border-slate-200 rounded-xl p-8 shadow-sm my-8">
    <div class="mb-6">
      <h1 class="text-xl font-bold text-slate-800">Create a New Post</h1>
      <p class="text-xs text-slate-500 mt-1">Share your questions or offers with the MotherConnect community.</p>
    </div>

    <!-- 投稿フォーム -->
    <form id="post-form" class="space-y-5">
      <!-- 投稿タイプの選択 -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2">Post Type</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center justify-center p-3 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50/50 transition">
            <input type="radio" name="post_type" value="request" checked class="text-pink-600 focus:ring-pink-500 mr-2" />
            <span class="text-sm font-medium text-slate-700">Request</span>
          </label>
          <label class="flex items-center justify-center p-3 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50/50 transition">
            <input type="radio" name="post_type" value="offer" class="text-pink-600 focus:ring-pink-500 mr-2" />
            <span class="text-sm font-medium text-slate-700">Offer</span>
          </label>
        </div>
      </div>

      <div>
        <label for="title" class="block text-xs font-semibold text-slate-700 mb-1">Title</label>
        <input 
          type="text" 
          id="title" 
          required 
          placeholder="e.g., Can you recommend a stroller?"
          class="w-full text-sm border border-slate-300 rounded-lg p-2.5 focus:outline-none focus:border-pink-500 focus:ring-1 focus:ring-pink-500"
        />
      </div>

      <div>
        <label for="content" class="block text-xs font-semibold text-slate-700 mb-1">Content</label>
        <textarea 
          id="content" 
          required 
          rows="5"
          placeholder="Enter your post here..."
          class="w-full text-sm border border-slate-300 rounded-lg p-2.5 focus:outline-none focus:border-pink-500 focus:ring-1 focus:ring-pink-500"
        ></textarea>
      </div>

      <div id="error-msg" class="text-xs text-red-600 hidden"></div>

      <div class="flex justify-end gap-3 pt-2">
        <a 
          href="/" 
          class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition"
        >
          Cancel
        </a>
        <button 
          type="submit" 
          class="bg-pink-600 text-white font-medium px-5 py-2 rounded-lg text-sm hover:bg-pink-700 transition shadow-sm"
        >
          Post
        </button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');

    // 1. 現在ログインしているユーザー情報を取得
    const { data: { session }, error: sessionError } = await supabase.auth.getSession();

    if (sessionError || !session) {
      alert('You must be signed in to post.');
      window.location.href = '/login';
      return;
    }

    // 選択された post_type を取得
    const postTypeInput = document.querySelector('input[name="post_type"]:checked') as HTMLInputElement;
    const postType = postTypeInput ? postTypeInput.value : 'request';

    const title = (document.getElementById('title') as HTMLInputElement).value;
    const content = (document.getElementById('content') as HTMLTextAreaElement).value;
    const userId = session.user.id;

    // 2. posts テーブルに post_type も一緒に挿入
    const { error: insertError } = await supabase
      .from('posts')
      .insert([
        { 
          title: title, 
          content: content, 
          post_type: postType,
          user_id: userId 
        }
      ]);

    if (insertError) {
      if (errorMsg) {
        errorMsg.textContent = 'Failed to create post: ' + insertError.message;
        errorMsg.classList.remove('hidden');
      }
      return;
    }

    // 3. 投稿成功したらトップページへリダイレクト
    alert('Post created successfully!');
    window.location.href = '/';
  });
</script>