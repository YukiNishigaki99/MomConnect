---
// src/components/Card.Astro
interface Props {
    title: string;
    type: 'need' | 'can';
    area: string;
    date: string;
}

const { title, type, area, date } = Astro.props;
const isNeed = type === 'need';
---

<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:shadow-md transition">
    <div class="flex justify-between items-start mb-3">
        <span class={`text-xs font-semibold px-3 py-1 rounded-full ${ isNeed ? 'bg-pink-100 text-pink-700'
            : 'bg-emerald-100 text-emerald-700' }`}>
            {isNeed ? 'Requesting Help' : 'Offering Help'}
        </span>
        <span class="text-xs text-slate-500 font-medium">{area}</span>
    </div>
    <h3 class="text-lg font-bold text-slate-800 mb-2">{title}</h3>
    <div class="flex justify-between items center text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100">
        <span>Date {date}</span>
        <span class="text-pink-600 font-medium hover:underline">View Detail</span>
    </div>
</div>